{
  "name": "typescript-commodore-64-emulator",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A hardware-focused Commodore 64 emulator written in strict TypeScript.",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "packageManager": "npm@11.9.0",
  "license": "MIT",
  "author": "JamesLinYJ",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark:emulation": "node --import tsx tools/benchmarkEmulation.ts",
    "generate:cpu-reference": "node --import tsx tools/generateCpuSingleStepFixture.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:cpu": "node --import tsx tools/verifyCpuReference.ts",
    "verify:cpu-single-step": "node --import tsx tools/verifyCpuSingleStepReference.ts",
    "verify:cpu-port": "node --import tsx tools/verifyCpuPortReference.ts",
    "verify:cartridge": "node --import tsx tools/verifyCartridgeReference.ts",
    "verify:easyflash": "node --import tsx tools/verifyEasyFlashReference.ts",
    "verify:cia": "node --import tsx tools/verifyCiaReference.ts",
    "verify:cia:new": "node --import tsx tools/verifyCiaReference.ts --new-cia",
    "verify:cia:nmi": "node --import tsx tools/verifyCiaReference.ts --nmi",
    "verify:cia:nmi:new": "node --import tsx tools/verifyCiaReference.ts --nmi --new-cia",
    "verify:cia:serial": "node --import tsx tools/verifyCiaSerialReferences.ts",
    "verify:cia:ports": "node --import tsx tools/verifyCiaPortReference.ts",
    "verify:via": "node --import tsx tools/verifyMos6522Reference.ts",
    "verify:drive": "node --import tsx tools/verifyDrive1541Reference.ts",
    "verify:drive:write-protect": "node --import tsx tools/verifyDrive1541Reference.ts --write-protect-only",
    "verify:drive:disk-change": "node --import tsx tools/verifyDrive1541Reference.ts --disk-change-only",
    "verify:drive:hls": "node --import tsx tools/verifyDrive1541Reference.ts --hls-only",
    "verify:tape": "node --import tsx tools/verifyDatasetteReference.ts",
    "verify:vic": "node --import tsx tools/verifyVicReference.ts",
    "verify:vic:sprites": "node --import tsx tools/verifyVicSpriteReference.ts",
    "verify:sid": "node --import tsx tools/verifySidReference.ts",
    "verify:prg-autostart": "node --import tsx tools/verifyPrgAutostartReference.ts",
    "verify:programs": "node --import tsx tools/verifyBundledPrograms.ts",
    "verify:browser": "node --import tsx tools/verifyBrowser.ts",
    "verify:reference": "npm run verify:cpu && npm run verify:cpu-single-step && npm run verify:cpu-port && npm run verify:cartridge && npm run verify:easyflash && npm run verify:cia && npm run verify:cia:new && npm run verify:cia:nmi && npm run verify:cia:nmi:new && npm run verify:cia:serial && npm run verify:cia:ports && npm run verify:via && npm run verify:tape && npm run verify:drive && npm run verify:vic && npm run verify:vic:sprites && npm run verify:sid && npm run verify:prg-autostart && npm run verify:programs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fast-check": "^4.9.0",
    "fflate": "0.8.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "playwright": "^1.61.1",
    "pngjs": "7.0.0",
    "prettier": "3.9.5",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
